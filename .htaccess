# Hostinger (Apache/LiteSpeed)
DirectoryIndex index.html
Options -Indexes

# Arquivos internos do repositório (o deploy via Git envia tudo): não ficam públicos
RedirectMatch 404 ^/(qa|_originais|\.git)(/|$)
RedirectMatch 404 ^/(README\.md|\.gitignore|\.nojekyll)$

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Ativar SÓ depois que o SSL estiver ligado no hPanel (tirar os # das 3 linhas):
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.stefanierafaeli.com.br%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS são versionados com ?v= no index.html: troque o v= a cada alteração
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
